# Backend (copy relevant values into Render's environment variable settings)
# Local dev default is a SQLite file next to the backend code; set this to
# the Supabase Postgres connection string in production.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/postgres

# JSON array of allowed frontend origins for CORS, e.g. your Vercel URL.
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# Frontend (copy into Vercel's environment variable settings, or a
# frontend/.env.local file for local testing against a deployed backend)
# Leave unset for local dev -- Vite's dev-server proxy (vite.config.ts)
# forwards /api, /media, /metrics, /health to http://127.0.0.1:8000.
VITE_API_BASE_URL=https://your-backend.onrender.com
